<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- External storage root -->
    <external-path
        name="external_root"
        path="." />

    <!-- App's private external storage -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Pictures directory -->
    <external-files-path
        name="pictures"
        path="Pictures/" />

    <!-- DCIM/Camera directory -->
    <external-path
        name="dcim"
        path="DCIM/" />

    <!-- Internal app storage -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Cache directory -->
    <cache-path
        name="cache"
        path="." />
</paths>